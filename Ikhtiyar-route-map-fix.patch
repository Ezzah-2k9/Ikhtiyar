+                dashArray: display.estimated ? '8 10' : undefined
+            }).addTo(targetMap);
+            line.bindTooltip(display.estimated
+                ? 'Approximate direction only — not a street-level route.'
+                : `${route.mode.toUpperCase()} route from a routing provider.`);
