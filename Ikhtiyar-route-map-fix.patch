+        function getRouteDisplayGeometry(route, origin, destination) {
+            const supplied = Array.isArray(route?.geometry)
+                ? route.geometry
+                    .filter(point => Array.isArray(point) && point.length >= 2
+                        && Number.isFinite(Number(point[0])) && Number.isFinite(Number(point[1])))
+                    .map(point => [Number(point[0]), Number(point[1])])
+                : [];
+            if (supplied.length >= 2) {
+                return { points: supplied, estimated: Boolean(route.is_estimate) };
+            }
+            return {
+                points: [[Number(origin.lat), Number(origin.lon)], [Number(destination.lat), Number(destination.lon)]],
+                estimated: true
+            };
+        }
+
+        function addRouteLine(targetMap, route, origin, destination) {
+            const display = getRouteDisplayGeometry(route, origin, destination);
